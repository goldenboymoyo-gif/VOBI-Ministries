# Copy to .env.local for local work. Never commit real values.

# Admin dashboard password (server only)
ADMIN_PASSWORD=

# Private GitHub repo used as the data store, and a token with Contents read/write on it (server only)
DATA_REPO=owner/repo
GITHUB_TOKEN=

# Vercel Blob (video uploads). Created by the Vercel Blob integration (server only)
BLOB_READ_WRITE_TOKEN=

# YouTube Data API v3 key for automatic live detection (server only, restrict to the YouTube Data API)
YOUTUBE_API_KEY=

# Public site address used in sitemap and robots (optional, defaults to the Vercel address)
NEXT_PUBLIC_SITE_URL=https://example.com
