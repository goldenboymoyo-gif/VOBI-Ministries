# VOBI API — copy to .env and fill in.

# Port the API listens on.
PORT=4000

# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:3000

# Bearer token required for every /api/admin/* route.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Optional. When set, submissions are stored in PostgreSQL instead of the
# JSON file store (see sql/schema.sql). Leave empty for the file store.
DATABASE_URL=

# Optional. Directory used by the JSON file store. Defaults to ./data
DATA_DIR=

# Set to "production" in deployment.
NODE_ENV=development
